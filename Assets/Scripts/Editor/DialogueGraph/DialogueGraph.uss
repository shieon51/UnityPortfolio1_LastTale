/* 노드 공통 */
.dialogue-node > #node-border {
    border-width: 2px;
    border-radius: 8px;
}

.dialogue-node #title {
    font-size: 13px;
    -unity-font-style: bold;
    padding-top: 4px;
    padding-bottom: 4px;
}

.dialogue-node #contents {
    padding: 6px;
}

/* 타입별 색상 */
.node-start > #node-border {
    border-color: rgb(80, 200, 120);
    background-color: rgba(40, 80, 55, 0.95);
}

.node-line > #node-border {
    border-color: rgb(90, 150, 220);
    background-color: rgba(38, 52, 70, 0.95);
}

.node-choice > #node-border {
    border-color: rgb(230, 180, 70);
    background-color: rgba(75, 62, 35, 0.95);
}

/* 텍스트 입력 필드 */
.dialogue-node TextField > .unity-base-text-field__input {
    border-radius: 4px;
    padding: 3px;
}

/* 선택지 행 */
.choice-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.condition-group { padding: 3px; }
.condition-row { flex-direction: row; align-items: center; margin-top: 2px; }
.condition-summary {
    -unity-font-style: italic;
    color: rgb(190, 190, 190);
    white-space: normal;
    padding: 2px 4px;
}
.choice-box {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 3px;
    margin-top: 3px;
}
.node-branch > #node-border {
    border-color: rgb(200, 110, 200);
    background-color: rgba(65, 40, 68, 0.95);
}

.dialogue-node {
    min-width: 520px;
    max-width: 520px;
}

.node-choice {
    min-width: 460px;
    max-width: 460px;
}

.line-box {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 5px;
    padding: 4px;
    margin-top: 4px;
    background-color: rgba(0, 0, 0, 0.15);
}

.compact-fold {
    margin-top: 3px;
}

.compact-fold > Toggle > Label {
    font-size: 11px;
    color: rgb(185, 185, 185);
}

/* 2단 레이아웃 */
.line-body {
    flex-direction: row;
    align-items: flex-start;
}

.line-left {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 240px;
    padding-right: 4px;
}

.line-right {
    width: 220px;
    flex-shrink: 0;
}

/* 대사 입력란 — 길어지면 줄바꿈 */
.line-text > .unity-base-text-field__input {
    min-height: 52px;
    white-space: normal;
}

/* 이름 입력란 — 최소 폭 보장 */
.line-box TextField {
    min-width: 60px;
}

/* 폴드 안 행이 좁아지지 않게 */
.line-right .condition-row {
    flex-wrap: wrap;
}
