/* 노드 공통 */
.dialogue-node > #node-border {
    border-width: 2px;
    border-radius: 8px;
}

.dialogue-node #title {
    font-size: 13px;
    -unity-font-style: bold;
    padding-top: 4px;
    padding-bottom: 4px;
}

.dialogue-node #contents {
    padding: 6px;
}

/* 타입별 색상 */
.node-start > #node-border {
    border-color: rgb(80, 200, 120);
    background-color: rgba(40, 80, 55, 0.95);
}

.node-line > #node-border {
    border-color: rgb(90, 150, 220);
    background-color: rgba(38, 52, 70, 0.95);
}

.node-choice > #node-border {
    border-color: rgb(230, 180, 70);
    background-color: rgba(75, 62, 35, 0.95);
}

/* 텍스트 입력 필드 */
.dialogue-node TextField > .unity-base-text-field__input {
    border-radius: 4px;
    padding: 3px;
}

/* 선택지 행 */
.choice-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.condition-group { padding: 3px; }
.condition-row { flex-direction: row; align-items: center; margin-top: 2px; }
.condition-summary {
    -unity-font-style: italic;
    color: rgb(190, 190, 190);
    white-space: normal;
    padding: 2px 4px;
}
.choice-box {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 3px;
    margin-top: 3px;
}
.node-branch > #node-border {
    border-color: rgb(200, 110, 200);
    background-color: rgba(65, 40, 68, 0.95);
}